# Canonical LLM Runtime Configuration
# Supported providers: "groq", "openai", "google", "gemini"
#
# Testing example (Groq):
#   LLM_PROVIDER=groq
#   LLM_MODEL=openai/gpt-oss-20b
#   LLM_API_KEY=your_api_key_here

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# Server & Pipeline Configuration
API_HOST=127.0.0.1
API_PORT=8001
ENVIRONMENT=development
TAXONOMY_PATH=docs/ai-contract/skills_seed.json
