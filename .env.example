# ================================================================
# SkillMatch AI Services - Centralized LLM & App Configuration
# ================================================================

# --- Unified Single Source of Truth for LLM Configuration ---
# Active Provider: "gemini", "openai", "groq", "anthropic", "ollama", "custom"
LLM_PROVIDER=gemini

# Primary API Key for the active provider
LLM_API_KEY=

# Model Identifier for the active provider (e.g. gemini-3.5-flash, gpt-4o-mini, llama-3.3-70b-versatile)
LLM_MODEL_NAME=gemini-3.5-flash

# Maximum token budget for completions (default: 4096 to prevent truncation of rich CVs/job profiles)
LLM_MAX_TOKENS=4096

# Generation temperature (default: 0.0 for deterministic structured JSON extraction)
LLM_TEMPERATURE=0.0

# Optional Custom Base URL (for OpenAI-compatible local gateways: Ollama, vLLM, LiteLLM)
LLM_BASE_URL=

# --- Optional Provider-Specific Fallback Keys ---
# Used for hybrid deployments or multi-provider routing where secondary keys coexist.
# The primary LLM_API_KEY above takes precedence for the active LLM_PROVIDER.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server & Pipeline Configuration ---
API_HOST=127.0.0.1
API_PORT=8001
ENVIRONMENT=development
TAXONOMY_PATH=docs/ai-contract/skills_seed.json
