# ================================================================
# SkillMatch AI Services - Centralized LLM & App Configuration
# ================================================================

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# Server & Pipeline Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
TAXONOMY_PATH=docs/ai-contract/skills_seed.json

# Jooble Integration
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://eg.jooble.org/api

# Service Authentication (Bearer Token)
AI_SERVICE_API_KEY=your_secure_ai_service_api_key_here
ENABLE_API_KEY_AUTH=true
